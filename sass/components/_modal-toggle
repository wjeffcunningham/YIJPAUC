.modal-toggle {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.modal-trigger {
  cursor: pointer;
  border-bottom: 1px dotted currentColor;
  font-style: normal;
}

.modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal-toggle:checked ~ .modal-overlay {
  display: block;
}

.modal-box {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  max-width: 36rem;
  width: 90%;
  padding: 2rem 2.5rem;
  background: var(--bg, #fff);
  border-top: 1px solid rgba(0, 0, 0, 0.25);
  border-bottom: 1px solid rgba(0, 0, 0, 0.25);
}

.modal-close {
  display: block;
  margin-top: 1.25rem;
  font-size: 0.7em;
  font-style: italic;
  opacity: 0.5;
  cursor: pointer;
  text-align: right;
  letter-spacing: 0.04em;
}

.modal-close:hover {
  opacity: 1;
}

/* reuse epigraph internals inside modal */
.modal-box .epigraph-body {
  margin: 0;
}